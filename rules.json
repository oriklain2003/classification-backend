  "classification_guidelines": {
    "primary_discriminators": [
      {
        "parameter": "time_of_day",
        "rules": [
          "Nighttime flight at 65-19,700 feet and 20-50 knots → likely nighttime migrating birds",
          "Daytime flight with zigzag pattern and altitude changes → likely soaring birds"
        ]
      },
      {
        "parameter": "altitude",
        "rules": [
          "0-100 feet → crop duster, attack helicopter, terrain-following missile, or low-flying UAV",
          "500-13,000 feet with 90-130 knots → potential Shahed-136 or similar Low & Slow UAV",
          "30,000-45,000 feet with high speed → fighter aircraft or High & Fast UAV",
          "Above 10,000 feet at night with 20-50 knots → nighttime migrating birds with collision risk"
        ]
      },
      {
        "parameter": "speed",
        "rules": [
          "20-80 knots → birds or very light aircraft",
          "80-160 knots → light aircraft, helicopters, or slow UAVs",
          "280-450 knots → cruise missiles or tactical transport",
          "Above 500 knots → fighter aircraft or fast UAVs"
        ]
      },
      {
        "parameter": "flight_pattern",
        "rules": [
          "Zigzag vertical and horizontal → soaring birds in thermals",
          "Straight and stable → cruise missiles, transport aircraft, or ISR UAVs",
          "Serpentine with terrain following → Quds-type terrain-following missile",
          "Sharp direction changes at very low altitude → crop duster or attack helicopter"
        ]
      },
      {
        "parameter": "location_context",
        "rules": [
          "Over water reservoirs or fish farms → likely birds (strong attraction)",
          "Jordan Valley, Dead Sea, Beit Shean during migration season → high probability of soaring birds",
          "Coastlines at night → nighttime migrating birds",
          "Strategic approach corridors → potential hostile UAVs or cruise missiles"
        ]
      }
    ],
    "secondary_indicators": [
      {
        "indicator": "altitude_stability",
        "interpretation": "Unstable/zigzag altitude changes suggest soaring birds; stable altitude suggests mechanical flight"
      },
      {
        "indicator": "speed_consistency",
        "interpretation": "Variable speed (slow in thermals, fast in glides) suggests birds; consistent speed suggests powered flight"
      },
      {
        "indicator": "heading_changes",
        "interpretation": "Frequent small heading changes suggest birds; straight track suggests missile or cruise flight"
      },
      {
        "indicator": "seasonal_context",
        "interpretation": "Spring/autumn increases bird probability; consider migration corridors"
      }
    ]
  },
  "special_notes": {
    "bird_behavior": [
      "Soaring birds descend at dusk and night (refueling)",
      "Nighttime migrants descend significantly at dawn for rest and feeding",
      "High concentrations near water bodies and migration corridors",
      "Predictability is low due to zigzag patterns"
    ],
    "uav_vulnerabilities": [
      "Low & Slow profiles highly susceptible to GPS jamming",
      "Terrain-following profiles difficult to detect on ground radar",
      "High & Fast profiles easier to detect but require long-range interceptors"
    ],
    "collision_risks": [
      "Birds pose highest risk to helicopters, UAVs, and aircraft at takeoff/landing",
      "Nighttime bird migration at 10,000+ feet risks encounter with operational aviation",
      "Terrain-following missiles provide only seconds of warning"
    ]
  }
}